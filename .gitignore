# Dependencies
node_modules

# Build
dist
*.tsbuildinfo
.turbo

# Tests
coverage

# Environment
.env*

# macOS
.DS_Store

# pnpm
.pnpm-store

# Turborepo
.turbo/

# Fixtures written by the boundary tests
**/__boundary_fixture__.ts

# Output of tsc --build (typecheck), distinct from dist/ which tsdown produces
.tsbuild/

# Output of the DMMF contract test.
.contract/

# Output of the integration tests, and the demo's Prisma client. The demo's
# Perch representation is checked in: it is read rather than run.
tooling/.generated/

# Fixtures the discovery suite writes while it runs.
tooling/.discover/

# An example generates its Prisma client; the Perch IR beside it is checked in,
# which is what lets an example typecheck and build with no database.
examples/*/src/generated/client/

# The built documentation site.
docs/.vitepress/dist
docs/.vitepress/cache

# Written by `panda codegen` and `panda cssgen`. Generated code, like the
# Prisma client in the demo: the build writes it, and a checkout that has not
# built has nothing to read.
packages/ui/src/styled-system
packages/ui/src/panda.css
