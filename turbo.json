{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".tsbuild/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "package:check": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@perchjs/tooling#typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@perchjs/docs#build": {
      "dependsOn": ["^build"],
      "outputs": [".vitepress/dist/**", ".vitepress/cache/**"]
    }
  }
}
