# The shape of this example's .env, which git does not carry.
# Copy it to .env and put the real credentials in. `pnpm start` reads .env;
# `prisma db push` reads the environment, so export DATABASE_URL for that.

# The PostgreSQL database of this example's own, on the shared server.
DATABASE_URL="postgresql://user:password@localhost:5432/hr"

# Pinned so this one and the bird example can run at once; that one takes 3000.
PORT=3100

# How often the data goes back to how it started, in minutes. 0 turns it off.
# DEMO_RESET_MINUTES=60
