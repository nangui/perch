{
  "name": "@perchjs/prisma",
  "version": "0.2.0",
  "description": "Perch Prisma adapter: query execution from the intermediate representation.",
  "homepage": "https://github.com/nangui/perch/tree/main/packages/prisma#readme",
  "keywords": [
    "perch",
    "nestjs",
    "admin-panel",
    "admin",
    "crud",
    "prisma",
    "typescript",
    "prisma-client",
    "postgresql",
    "query"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nangui/perch.git",
    "directory": "packages/prisma"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --build",
    "lint": "eslint src",
    "package:check": "publint && attw --pack ."
  },
  "dependencies": {
    "@perchjs/core": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": "^7.0.0"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.1"
  }
}
