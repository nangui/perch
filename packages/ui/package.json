{
  "name": "@perchjs/ui",
  "version": "0.0.0",
  "description": "Perch React renderer and component registry. Shipped precompiled.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --build",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@perchjs/core": "workspace:*"
  }
}
