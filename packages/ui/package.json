{
  "name": "@perchjs/ui",
  "version": "0.0.0",
  "description": "Perch React renderer and component registry. Shipped precompiled.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/styles.css --format esm --dts --clean --tsconfig tsconfig.build.json --external react --external react-dom",
    "typecheck": "tsc --build",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7"
  },
  "devDependencies": {
    "@perchjs/core": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
