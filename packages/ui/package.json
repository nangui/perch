{
  "name": "@perchjs/ui",
  "version": "0.4.0",
  "description": "Perch React renderer and component registry. Shipped precompiled.",
  "homepage": "https://github.com/nangui/perch/tree/main/packages/ui#readme",
  "keywords": [
    "perch",
    "nestjs",
    "admin-panel",
    "admin",
    "crud",
    "prisma",
    "typescript",
    "react",
    "renderer",
    "components"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nangui/perch.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run generate && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
    "typecheck": "pnpm run generate && tsc --build",
    "lint": "pnpm run generate && eslint src",
    "package:check": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
    "generate": "panda codegen && panda cssgen --outfile src/panda.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.3",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.1.1",
    "@pandacss/preset-base": "^2.1.1",
    "@pandacss/preset-panda": "^2.1.1",
    "@perchjs/core": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
