{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/.tsbuildinfo",

    // NestJS rests on legacy decorators and on constructor property injection,
    // so the three settings below are relaxed here and here only: the domain
    // (`core`) stays free of decorators and of emitted metadata.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "erasableSyntaxOnly": false
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../core" }]
}
