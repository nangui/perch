{
  "name": "@perchjs/prisma-generator",
  "version": "0.2.0",
  "description": "Perch Prisma generator: emits the intermediate representation at build time.",
  "homepage": "https://github.com/nangui/perch/tree/main/packages/prisma-generator#readme",
  "keywords": [
    "perch",
    "nestjs",
    "admin-panel",
    "admin",
    "crud",
    "prisma",
    "typescript",
    "prisma-generator",
    "codegen",
    "dmmf"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nangui/perch.git",
    "directory": "packages/prisma-generator"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "perch-prisma-generator": "./dist/generator.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --build",
    "lint": "eslint src",
    "package:check": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@perchjs/core": "workspace:*",
    "@prisma/generator-helper": "^7.0.0"
  },
  "devDependencies": {
    "prisma": "^7.9.1"
  }
}
